<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="gameboost_overlay_prefs.xml" />
        <exclude domain="database" path="gameboost_database" />
        <exclude domain="sharedpref" path="gameboost_permissions_prefs.xml" />
        <exclude domain="sharedpref" path="gameboost_session_restore.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="gameboost_overlay_prefs.xml" />
        <exclude domain="sharedpref" path="gameboost_session_restore.xml" />
    </device-transfer>
</data-extraction-rules>
