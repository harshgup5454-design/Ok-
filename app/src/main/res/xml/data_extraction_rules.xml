<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Strict allowlist: only user overlay preferences are backed up/transferred; device-specific state and local Room DB are excluded -->
    <cloud-backup>
        <include domain="sharedpref" path="gameboost_overlay_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="gameboost_overlay_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
